<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Storage report{{if .D.Host}} — {{.D.Host}}{{end}}</title>
<style>
  :root {
    --bg:#f5f5f7; --surface:#ffffff; --fg:#1d1d1f; --muted:#6e6e73; --faint:#a1a1a6; --line:#e3e3e8;
    --warn:#c26a00; --bad:#c9342b;
    --c0:#7aa2d6; --c1:#e3a857; --c2:#83c29e; --c3:#d98a85; --c4:#a99bd1; --c5:#77bcc9; --c6:#cdb86f; --c7:#b3a594; --c8:#95afc4; --c9:#c9a1bf;
    --cx:#d4d4d9; --free:#e8e8ed; --tile-text:#1d1d1f;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg:#1c1c1e; --surface:#262628; --fg:#f2f2f7; --muted:#98989d; --faint:#636366; --line:#38383a;
      --warn:#ffb340; --bad:#ff6961;
      --c0:#3e5f8a; --c1:#8a6633; --c2:#3f7458; --c3:#8a4c48; --c4:#5f5487; --c5:#3d6e78; --c6:#7a6c3a; --c7:#675d52; --c8:#4f6476; --c9:#7a5674;
      --cx:#48484a; --free:#323234; --tile-text:#f2f2f7;
    }
  }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--fg); font:14px/1.5 -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", sans-serif; -webkit-font-smoothing:antialiased; }
  main { max-width:980px; margin:0 auto; padding:40px 20px 72px; }
  header { display:flex; justify-content:space-between; align-items:baseline; gap:16px; flex-wrap:wrap; }
  h1 { font-size:24px; font-weight:600; margin:0; letter-spacing:-0.01em; }
  h2 { font-size:15px; font-weight:600; margin:0 0 12px; }
  .muted { color:var(--muted); } .faint { color:var(--faint); }
  section { background:var(--surface); border:1px solid var(--line); border-radius:12px; padding:20px; margin-top:16px; }
  .num { font-variant-numeric:tabular-nums; }
  code { font:12.5px ui-monospace, SFMono-Regular, Menlo, monospace; color:var(--muted); }

  /* storage bar */
  .disk-head { display:flex; justify-content:space-between; align-items:baseline; margin-bottom:10px; }
  .disk-head strong { font-size:15px; font-weight:600; }
  .bar { display:flex; height:22px; border-radius:6px; overflow:hidden; background:var(--free); }
  .bar span { display:block; height:100%; border-right:1px solid var(--surface); }
  .bar span:last-child { border-right:0; }
  .legend { display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:6px 24px; margin-top:16px; }
  .legend div { display:grid; grid-template-columns:12px 1fr auto; gap:0 10px; align-items:baseline; padding:3px 0; }
  .legend i { width:10px; height:10px; border-radius:3px; display:inline-block; transform:translateY(1px); }
  .legend small { grid-column:2 / 4; color:var(--faint); font-size:12px; }

  /* stats */
  .stats { display:grid; grid-template-columns:repeat(3, 1fr); }
  .stats > div { padding:4px 20px; border-left:1px solid var(--line); }
  .stats > div:first-child { border-left:0; padding-left:0; }
  .stats .v { font-size:22px; font-weight:600; letter-spacing:-0.01em; }
  .stats .l { color:var(--muted); font-size:13px; }

  /* treemap */
  .map svg { display:block; width:100%; height:auto; border-radius:8px; }
  svg text { font-size:11.5px; fill:var(--tile-text); pointer-events:none; }
  svg text.name { font-weight:600; }
  svg text.size { opacity:.7; }
  svg rect { stroke:var(--surface); stroke-width:2; }
  svg rect.leaf { stroke-width:1; }
  svg rect:hover { filter:brightness(1.06); }

  /* tables */
  table { width:100%; border-collapse:collapse; }
  th, td { text-align:left; padding:9px 8px; border-top:1px solid var(--line); vertical-align:baseline; }
  thead th { border-top:0; color:var(--muted); font-size:12px; font-weight:500; padding-top:0; }
  td.size { text-align:right; white-space:nowrap; }
  th.size { text-align:right; }
  .risk { font-size:12px; color:var(--muted); }
  .risk.review { color:var(--warn); }
  .desc { color:var(--muted); font-size:13px; }

  /* health */
  .finding { display:grid; grid-template-columns:10px 140px 1fr; gap:0 12px; padding:10px 0; border-top:1px solid var(--line); align-items:baseline; }
  .finding:first-of-type { border-top:0; padding-top:0; }
  .dot { width:8px; height:8px; border-radius:50%; background:var(--faint); display:inline-block; }
  .dot.bad { background:var(--bad); } .dot.warn { background:var(--warn); } .dot.info { background:#5e9ce6; } .dot.ok { background:#4fb286; }
  .finding details { color:var(--muted); font-size:13px; }
  .finding summary { cursor:pointer; color:var(--fg); font-size:14px; list-style:none; }
  .finding summary::-webkit-details-marker { display:none; }
  .finding ul { margin:6px 0 0; padding-left:18px; }
  footer { margin-top:28px; font-size:12px; color:var(--faint); text-align:center; }
  footer a { color:inherit; }
  @media (max-width:700px) {
    .stats { grid-template-columns:1fr; } .stats > div { border-left:0; padding:6px 0; }
    td.desc, th.desc { display:none; } .finding { grid-template-columns:10px 1fr; } .finding .check { grid-column:2; }
  }
</style>
</head>
<body>
<main>
  <header>
    <h1>Storage report</h1>
    <div class="muted">{{if .D.Host}}{{.D.Host}} · {{end}}{{.D.Generated.Format "2 January 2006, 15:04"}}</div>
  </header>

  <section>
    <div class="disk-head">
      <strong>Macintosh HD</strong>
      <span class="muted num">{{human .D.Free}} free of {{human .D.Total}}</span>
    </div>
    <div class="bar" role="img" aria-label="Disk usage by category">
      {{range .Segments}}<span style="width:{{.Pct}}%;background:var(--{{.Class}})" title="{{.Name}} — {{.Size}}"></span>{{end}}
    </div>
    <div class="legend">
      {{range .Segments}}
      <div><i style="background:var(--{{.Class}})"></i><span>{{.Name}}</span><span class="num muted">{{.Size}}</span>{{if .Hint}}<small>{{.Hint}}</small>{{end}}</div>
      {{end}}
    </div>
  </section>

  <section>
    <div class="stats">
      <div><div class="l">Free</div><div class="v num">{{human .D.Free}}</div></div>
      <div><div class="l">Safe to clean</div><div class="v num">{{human .D.Safe}}</div><code>macclean clean</code></div>
      <div><div class="l">Worth reviewing</div><div class="v num">{{human .D.Review}}</div><code>macclean ui</code></div>
    </div>
  </section>

  {{if .Tiles}}
  <section class="map">
    <h2>Home folder <span class="muted num" style="font-weight:400">{{human .D.Tree.Size}}</span></h2>
    <svg viewBox="0 0 {{.W}} {{.H}}" role="img" aria-label="Map of the home folder">
      {{range .Tiles}}
      <g>
        <rect class="{{if not .Parent}}leaf{{end}}" x="{{.X}}" y="{{.Y}}" width="{{.W}}" height="{{.H}}" rx="3" style="fill:var(--{{.Class}});{{if not .Parent}}fill-opacity:.55{{end}}"><title>{{.Title}}</title></rect>
        {{if .Label}}<text class="name" x="{{add .X 8}}" y="{{add .Y 16}}">{{short .Name .W}}</text>{{end}}
        {{if and .Label .Parent}}<text class="size" x="{{add .X .W -8}}" y="{{add .Y 16}}" text-anchor="end">{{.Size}}</text>{{end}}
        {{if and .Two (not .Parent)}}<text class="size" x="{{add .X 8}}" y="{{add .Y 31}}">{{.Size}}</text>{{end}}
      </g>
      {{end}}
    </svg>
    <p class="faint" style="margin:10px 0 0;font-size:12.5px">Hover a block for its full path. Explore from the terminal with <code>macclean top &lt;folder&gt;</code>.</p>
  </section>
  {{end}}

  <section>
    <h2>What can be cleaned</h2>
    <table>
      <thead><tr><th>Category</th><th class="size">Size</th><th>Command</th><th class="desc">Removes</th></tr></thead>
      <tbody>
      {{range .D.Categories}}{{if .Bytes}}
        <tr>
          <td>{{.Name}}<div class="risk {{.Risk}}">{{if eq .Risk "safe"}}Safe{{else}}Review first{{end}}</div></td>
          <td class="size num">{{if .Known}}{{human .Bytes}}{{else}}—{{end}}</td>
          <td><code>macclean clean --only {{.ID}}</code></td>
          <td class="desc">{{.Desc}}</td>
        </tr>
      {{end}}{{end}}
      </tbody>
    </table>
  </section>

  {{if .D.Findings}}
  <section>
    <h2>Health</h2>
    {{range .D.Findings}}
    <div class="finding">
      <span class="dot {{.Severity}}"></span>
      <span class="check">{{.Check}}</span>
      {{if .Advice}}
      <details><summary>{{.Short}}</summary>{{.Summary}}<ul>{{range .Advice}}<li>{{.}}</li>{{end}}</ul></details>
      {{else}}
      <span>{{.Short}}</span>
      {{end}}
    </div>
    {{end}}
  </section>
  {{end}}

  <footer>Made by <a href="https://github.com/iamolayemi/macclean">macclean</a> {{.D.Version}}. Nothing was changed on your Mac to produce this report.</footer>
</main>
</body>
</html>
